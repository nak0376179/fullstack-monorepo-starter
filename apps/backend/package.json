{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 8000",
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check --fix .",
    "format": "uv run ruff format .",
    "test": "uv run pytest",
    "build": "uv export --no-hashes --no-dev -o requirements.txt",
    "package": "pnpm build && sam build",
    "deploy": "pnpm package && sam deploy"
  }
}
